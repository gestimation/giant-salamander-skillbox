{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samplesize200.local/schemas/calculation-batch-v2.0.0.json",
  "title": "samplesize200 CalculationBatch",
  "type": "object",
  "required": ["schema_version", "study_spec", "calculation_requests"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "study_spec": {"type": "object"},
    "calculation_requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "request_id", "requested_output"]
      }
    },
    "interaction_context": {"type": "object"},
    "execution_policy": {
      "type": "object",
      "properties": {
        "parallelism": {"type": "integer", "minimum": 1, "maximum": 8}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
