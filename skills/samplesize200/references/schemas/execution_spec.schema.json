{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samplesize200.local/schemas/execution-spec-v2.0.0.json",
  "title": "SAMPLESIZE200 ExecutionSpec",
  "description": "Minimal deterministic payload at the engine boundary.",
  "type": "object",
  "required": [
    "schema_version", "study_spec_revision", "procedure_key",
    "engine_procedure_id", "requested_output", "engine_calculation_target",
    "scenarios", "fingerprint_version", "input_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "study_spec_revision": {"type": "integer", "minimum": 1},
    "request_id": {"type": "string", "minLength": 1},
    "calculator_id": {"type": ["string", "null"]},
    "procedure_key": {"type": "string"},
    "engine_procedure_id": {"type": "string"},
    "requested_output": {"type": "string"},
    "engine_calculation_target": {"type": "string"},
    "scenarios": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "fingerprint_version": {"const": "ss200-exec-v1"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
