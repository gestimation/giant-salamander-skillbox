{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samplesize200.local/schemas/study-patch-v2.0.0.json",
  "title": "SAMPLESIZE200 StudySpec patch",
  "type": "object",
  "required": ["base_revision", "operations"],
  "properties": {
    "base_revision": {"type": "integer", "minimum": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "properties": {
          "op": {"enum": ["add", "replace", "remove"]},
          "path": {"type": "string", "pattern": "^/(study|values)/[^/]+(?:/[^/]+)*$"},
          "value": {}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
